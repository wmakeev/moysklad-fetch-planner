{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/fetch-types.ts",
    "samples/types.ts",
    "samples/batchStat.ts",
    "samples/demo.ts",
    "samples/wait-for-request-slot-1.ts",
    "samples/wait-for-request-slot-2.ts",
    "test/package/fixtures/*.{ts,mjs}"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.{ts,mjs}",
    "samples/**/*.ts",
    "scripts/**/*.{js,mjs,cjs,ts}"
  ],
  "includeEntryExports": false,
  "ignoreDependencies": ["dotenv"],
  "ignoreBinaries": ["report"],
  "ignoreIssues": {
    "test/package/fixtures/custom.ts": ["duplicates"],
    "test/package/fixtures/events-bytes.ts": ["duplicates"],
    "test/package/fixtures/subclass.ts": ["duplicates"]
  }
}
