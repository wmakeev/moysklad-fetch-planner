{
  "name": "moysklad-fetch-planner",
  "version": "3.2.0",
  "type": "module",
  "description": "Планировщик запросов для API МойСклад",
  "files": [
    "build/src/",
    "src/"
  ],
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "keywords": [
    "moysklad",
    "api",
    "fetch",
    "request",
    "rate-limit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wmakeev/moysklad-fetch-planner"
  },
  "scripts": {
    "env:example": "npx sync-dotenv",
    "compile:dev": "pnpm run build:test",
    "compile": "rm -rf build/ && tsc -p tsconfig.prod.json",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test samples scripts",
    "coverage": "pnpm run build:test && c8 pnpm run test:unit && pnpm run coverage:check",
    "coverage:report": "c8 report && pnpm run coverage:check",
    "coverage:check": "node scripts/check-coverage.mjs",
    "build:dev": "pnpm run build:test",
    "build": "pnpm run compile",
    "test": "pnpm run build:test && pnpm run test:unit",
    "test:unit": "node --test --enable-source-maps __temp/test-build/test/index.test.js",
    "test:live": "pnpm run build:test && node --enable-source-maps __temp/test-build/test/stress.test.js",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "release": "np",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "rm -rf __temp/test-build/ && tsc -p tsconfig.test.json",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"samples/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.prod.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"samples/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.prod.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md"
  },
  "engines": {
    "node": ">=24"
  },
  "c8": {
    "include": [
      "__temp/test-build/src/**/*.js",
      "src/**/*.ts"
    ],
    "exclude-after-remap": true,
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "author": {
    "name": "Vitaliy V. Makeev",
    "email": "w.makeev@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node22": "22.0.0",
    "@tsconfig/strictest": "2.0.5",
    "@types/highland": "2.13.0",
    "@types/node": "22.20.5",
    "@wmakeev/highland-tools": "3.1.0",
    "auto-changelog": "2.5.0",
    "c8": "12.0.0",
    "csv-stringify": "6.5.2",
    "dotenv": "16.4.7",
    "highland": "2.13.5",
    "moysklad": "0.20.0",
    "p-retry": "6.2.1",
    "piscina": "5.0.0-alpha.0",
    "typescript": "7.0.2",
    "undici": "7.3.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxfmt": "0.75.0",
    "knip": "6.44.0",
    "np": "12.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
