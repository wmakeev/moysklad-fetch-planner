{
  "name": "moysklad-fetch-planner",
  "version": "4.1.0",
  "type": "module",
  "description": "Планировщик запросов для API МойСклад",
  "files": [
    "build/src/",
    "src/"
  ],
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "keywords": [
    "moysklad",
    "api",
    "fetch",
    "request",
    "rate-limit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wmakeev/moysklad-fetch-planner"
  },
  "scripts": {
    "env:example": "npx sync-dotenv",
    "compile:dev": "pnpm run build:test",
    "compile": "rm -rf build/ && tsc -p tsconfig.prod.json",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test samples scripts",
    "coverage": "pnpm run build:test && c8 pnpm run test:unit && pnpm run coverage:check",
    "coverage:report": "c8 report && pnpm run coverage:check",
    "coverage:check": "node scripts/check-coverage.mjs",
    "build:dev": "pnpm run build:test",
    "build": "pnpm run compile",
    "test": "pnpm run build:test && pnpm run test:unit",
    "test:unit": "node test/operation/run.mjs all && node --test --enable-source-maps __temp/test-build/test/index.test.js __temp/test-build/test/pacing.test.js __temp/test-build/test/response-policy.test.js __temp/test-build/test/lifecycle.test.js __temp/test-build/test/scheduler.test.js __temp/test-build/test/parallel.test.js __temp/test-build/test/body-cleanup.test.js __temp/test-build/test/compatibility.test.js __temp/test-build/test/fetch-contract.test.js",
    "test:live": "pnpm run build:test && node --enable-source-maps __temp/test-build/test/stress.test.js",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "release": "np",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "rm -rf __temp/test-build/ && tsc -p tsconfig.test.json",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"test/**/*.mjs\" \"samples/**/*.ts\" \"scripts/**/*.mjs\" package.json knip.json tsconfig.json tsconfig.prod.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"test/**/*.mjs\" \"samples/**/*.ts\" \"scripts/**/*.mjs\" package.json knip.json tsconfig.json tsconfig.prod.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml README.md",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && node scripts/check-tooling.mjs && pnpm run test",
    "prepack": "pnpm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "c8": {
    "include": [
      "__temp/test-build/src/**/*.js",
      "__temp/operation-build/src/**/*.js",
      "src/**/*.ts"
    ],
    "exclude-after-remap": true,
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "author": {
    "name": "Vitaliy V. Makeev",
    "email": "w.makeev@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/highland": "2.13.0",
    "@types/node": "24.19.2",
    "@wmakeev/highland-tools": "3.1.0",
    "auto-changelog": "2.5.0",
    "c8": "12.0.0",
    "csv-stringify": "6.5.2",
    "dotenv": "16.4.7",
    "highland": "2.13.5",
    "piscina": "5.3.2",
    "typescript": "7.0.2",
    "undici": "7.30.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxfmt": "0.75.0",
    "knip": "6.44.0",
    "np": "12.1.1",
    "undici8": "npm:undici@8.12.2",
    "undici8-baseline": "npm:undici@8.11.2"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "undici-types": "7.3.0",
    "undici-types-modern": "npm:undici-types@7.30.1",
    "undici-types8": "npm:undici-types@8.12.2"
  }
}
