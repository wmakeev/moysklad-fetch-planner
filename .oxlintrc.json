{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "node",
    "import",
    "promise"
  ],
  "env": {
    "node": true,
    "es2023": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "for-direction": [
      2
    ],
    "no-async-promise-executor": [
      2
    ],
    "no-case-declarations": [
      2
    ],
    "no-compare-neg-zero": [
      2
    ],
    "no-cond-assign": [
      2,
      "except-parens"
    ],
    "no-constant-binary-expression": [
      2
    ],
    "no-constant-condition": [
      2,
      {
        "checkLoops": "allExceptWhileTrue"
      }
    ],
    "no-control-regex": [
      2
    ],
    "no-debugger": [
      2
    ],
    "no-delete-var": [
      2
    ],
    "no-dupe-else-if": [
      2
    ],
    "no-duplicate-case": [
      2
    ],
    "no-empty": [
      2,
      {
        "allowEmptyCatch": false
      }
    ],
    "no-empty-character-class": [
      2
    ],
    "no-empty-pattern": [
      2,
      {
        "allowObjectPatternsAsParameters": false
      }
    ],
    "no-empty-static-block": [
      2
    ],
    "no-ex-assign": [
      2
    ],
    "no-extra-boolean-cast": [
      2,
      {}
    ],
    "no-fallthrough": [
      2,
      {
        "allowEmptyCase": false,
        "reportUnusedFallthroughComment": false
      }
    ],
    "no-global-assign": [
      2,
      {
        "exceptions": []
      }
    ],
    "no-invalid-regexp": [
      2,
      {}
    ],
    "no-irregular-whitespace": [
      2,
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "no-loss-of-precision": [
      2
    ],
    "no-misleading-character-class": [
      2
    ],
    "no-nonoctal-decimal-escape": [
      2
    ],
    "no-prototype-builtins": [
      2
    ],
    "no-regex-spaces": [
      2
    ],
    "no-self-assign": [
      2,
      {
        "props": true
      }
    ],
    "no-shadow-restricted-names": [
      2
    ],
    "no-sparse-arrays": [
      2
    ],
    "no-unexpected-multiline": [
      2
    ],
    "no-unsafe-finally": [
      2
    ],
    "no-unsafe-optional-chaining": [
      2,
      {
        "disallowArithmeticOperators": false
      }
    ],
    "no-unused-labels": [
      2
    ],
    "no-unused-private-class-members": [
      2
    ],
    "no-useless-backreference": [
      2
    ],
    "no-useless-catch": [
      2
    ],
    "no-useless-escape": [
      2
    ],
    "no-with": [
      2
    ],
    "require-yield": [
      2
    ],
    "use-isnan": [
      2,
      {
        "enforceForIndexOf": false,
        "enforceForSwitchCase": true
      }
    ],
    "valid-typeof": [
      2,
      {
        "requireStringLiterals": false
      }
    ],
    "node/no-exports-assign": [
      2
    ],
    "no-var": [
      2
    ],
    "prefer-const": [
      2,
      {
        "destructuring": "any",
        "ignoreReadBeforeAssign": false
      }
    ],
    "prefer-rest-params": [
      2
    ],
    "prefer-spread": [
      2
    ],
    "typescript/await-thenable": [
      2
    ],
    "typescript/ban-ts-comment": [
      1,
      {
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/no-array-delete": [
      2
    ],
    "typescript/no-base-to-string": [
      2
    ],
    "typescript/no-confusing-void-expression": [
      2
    ],
    "typescript/no-deprecated": [
      2
    ],
    "typescript/no-duplicate-enum-values": [
      2
    ],
    "typescript/no-duplicate-type-constituents": [
      2
    ],
    "typescript/no-dynamic-delete": [
      2
    ],
    "typescript/no-empty-object-type": [
      2
    ],
    "typescript/no-explicit-any": [
      2
    ],
    "typescript/no-extra-non-null-assertion": [
      2
    ],
    "typescript/no-extraneous-class": [
      2
    ],
    "typescript/no-floating-promises": [
      2,
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": "it",
            "package": "node:test"
          },
          {
            "from": "package",
            "name": "test",
            "package": "node:test"
          },
          {
            "from": "package",
            "name": "skip",
            "package": "node:test"
          },
          {
            "from": "package",
            "name": "only",
            "package": "node:test"
          },
          {
            "from": "package",
            "name": "stringToUint8Array",
            "package": "uint8array-extras"
          }
        ]
      }
    ],
    "typescript/no-for-in-array": [
      2
    ],
    "typescript/no-implied-eval": [
      2
    ],
    "typescript/no-invalid-void-type": [
      2
    ],
    "typescript/no-meaningless-void-operator": [
      2
    ],
    "typescript/no-misused-new": [
      2
    ],
    "typescript/no-misused-promises": [
      2
    ],
    "typescript/no-misused-spread": [
      2
    ],
    "typescript/no-mixed-enums": [
      2
    ],
    "typescript/no-namespace": [
      2
    ],
    "typescript/no-non-null-asserted-nullish-coalescing": [
      2
    ],
    "typescript/no-non-null-asserted-optional-chain": [
      2
    ],
    "typescript/no-non-null-assertion": [
      2
    ],
    "typescript/no-redundant-type-constituents": [
      2
    ],
    "typescript/no-require-imports": [
      2
    ],
    "typescript/no-this-alias": [
      2
    ],
    "typescript/no-unnecessary-boolean-literal-compare": [
      2
    ],
    "typescript/no-unnecessary-condition": [
      1
    ],
    "typescript/no-unnecessary-template-expression": [
      2
    ],
    "typescript/no-unnecessary-type-arguments": [
      2
    ],
    "typescript/no-unnecessary-type-assertion": [
      2
    ],
    "typescript/no-unnecessary-type-constraint": [
      2
    ],
    "typescript/no-unnecessary-type-parameters": [
      2
    ],
    "typescript/no-unsafe-argument": [
      2
    ],
    "typescript/no-unsafe-assignment": [
      2
    ],
    "typescript/no-unsafe-call": [
      2
    ],
    "typescript/no-unsafe-declaration-merging": [
      2
    ],
    "typescript/no-unsafe-enum-comparison": [
      2
    ],
    "typescript/no-unsafe-function-type": [
      2
    ],
    "typescript/no-unsafe-member-access": [
      2
    ],
    "typescript/no-unsafe-return": [
      2
    ],
    "typescript/no-unsafe-unary-minus": [
      2
    ],
    "typescript/no-wrapper-object-types": [
      2
    ],
    "typescript/only-throw-error": [
      2
    ],
    "typescript/prefer-as-const": [
      2
    ],
    "typescript/prefer-literal-enum-member": [
      2
    ],
    "typescript/prefer-namespace-keyword": [
      2
    ],
    "typescript/prefer-promise-reject-errors": [
      2
    ],
    "typescript/prefer-reduce-type-parameter": [
      2
    ],
    "typescript/prefer-return-this-type": [
      2
    ],
    "typescript/related-getter-setter-pairs": [
      2
    ],
    "typescript/require-await": [
      2
    ],
    "typescript/restrict-plus-operands": [
      2,
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNullish": false,
        "allowNumberAndString": false,
        "allowRegExp": false
      }
    ],
    "typescript/return-await": [
      2,
      "error-handling-correctness-only"
    ],
    "typescript/triple-slash-reference": [
      2
    ],
    "typescript/unbound-method": [
      2
    ],
    "typescript/unified-signatures": [
      2
    ],
    "typescript/use-unknown-in-catch-callback-variable": [
      2
    ],
    "typescript/adjacent-overload-signatures": [
      2
    ],
    "typescript/array-type": [
      2
    ],
    "typescript/ban-tslint-comment": [
      2
    ],
    "typescript/class-literal-property-style": [
      2
    ],
    "typescript/consistent-generic-constructors": [
      2
    ],
    "typescript/consistent-indexed-object-style": [
      2
    ],
    "typescript/consistent-type-assertions": [
      2
    ],
    "typescript/consistent-type-definitions": [
      2
    ],
    "typescript/dot-notation": [
      2,
      {
        "allowIndexSignaturePropertyAccess": false,
        "allowKeywords": true,
        "allowPattern": "",
        "allowPrivateClassPropertyAccess": false,
        "allowProtectedClassPropertyAccess": false
      }
    ],
    "typescript/no-confusing-non-null-assertion": [
      2
    ],
    "typescript/no-inferrable-types": [
      2
    ],
    "typescript/non-nullable-type-assertion-style": [
      2
    ],
    "typescript/prefer-find": [
      2
    ],
    "typescript/prefer-for-of": [
      2
    ],
    "typescript/prefer-function-type": [
      2
    ],
    "typescript/prefer-includes": [
      2
    ],
    "typescript/prefer-nullish-coalescing": [
      2
    ],
    "typescript/prefer-optional-chain": [
      2
    ],
    "typescript/prefer-regexp-exec": [
      2
    ],
    "typescript/prefer-string-starts-ends-with": [
      2
    ],
    "no-array-constructor": [
      2
    ],
    "no-unused-expressions": [
      2,
      {
        "allowShortCircuit": false,
        "allowTaggedTemplates": false,
        "allowTernary": false
      }
    ],
    "no-unused-vars": [
      2
    ],
    "no-useless-constructor": [
      2
    ],
    "no-empty-function": [
      2,
      {
        "allow": []
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "exit",
        "message": "Library code must not terminate the host process"
      }
    ]
  },
  "ignorePatterns": [
    "build/**",
    "__temp/**",
    "coverage/**",
    "docs/**"
  ]
}
